# Gmail account used to send memorial tribute notifications
GMAIL_USER=your.sender.gmail@gmail.com
# Use a Google App Password, NOT your normal Gmail password
GMAIL_APP_PASSWORD=your_16_character_app_password
# Dedicated Gmail inbox where tributes and approval notifications should arrive
TRIBUTES_TO=family.memorial.inbox@gmail.com
# Public website URL used to create secure approval links (no trailing slash)
SITE_URL=https://your-deployed-domain.example
PORT=3000
